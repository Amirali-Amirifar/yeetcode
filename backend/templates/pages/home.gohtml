{{ template "header" .}}


<div class="min-h-screen flex flex-col bg-gray-50">
    <div class="w-full bg-gradient-to-r from-blue-600 to-indigo-700 h-[350px] flex flex-col items-center justify-center text-center px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-3">Welcome to Yeet Code</h1>
        <p class="mt-2 text-lg text-blue-100 max-w-2xl">Practice your coding skills, prepare for interviews, and challenge yourself with a variety of problems.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href="/problems" class="px-6 py-3 bg-white text-blue-700 font-semibold rounded-lg shadow-md hover:bg-gray-100 transition duration-300">
                Browse Problems
            </a>
            {{if .IsLoggedIn}}
                {{if eq .UserRole "admin"}}
                    <a href="/admin" class="px-6 py-3 bg-purple-500 text-white font-semibold rounded-lg shadow-md hover:bg-purple-600 transition duration-300 flex items-center gap-2">
                        <svg style="width: 20px !important; height: 20px !important;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        Admin Dashboard
                    </a>
                {{end}}
                <a href="/problems/new" class="px-6 py-3 bg-indigo-500 text-white font-semibold rounded-lg shadow-md hover:bg-indigo-600 transition duration-300 flex items-center gap-2">
                    <svg style="width: 20px !important; height: 20px !important;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    Create Problem
                </a>
            {{end}}
        </div>
    </div>

    <div class="container mx-auto my-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 px-4">
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 transition-transform transform hover:-translate-y-1">
            <h2 class="text-xl font-semibold text-gray-800">Easy Problems</h2>
            <p class="mt-2 text-gray-600 text-sm">Start with easy problems to build your confidence.</p>
            <a href="/problems?difficulty=Easy" class="mt-4 inline-block px-4 py-2 bg-green-100 text-green-800 text-sm font-medium rounded-full hover:bg-green-200 transition duration-300">Explore Easy</a>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 transition-transform transform hover:-translate-y-1">
            <h2 class="text-xl font-semibold text-gray-800">Medium Problems</h2>
            <p class="mt-2 text-gray-600 text-sm">Challenge yourself with medium-level problems.</p>
            <a href="/problems?difficulty=Medium" class="mt-4 inline-block px-4 py-2 bg-yellow-100 text-yellow-800 text-sm font-medium rounded-full hover:bg-yellow-200 transition duration-300">Explore Medium</a>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 transition-transform transform hover:-translate-y-1">
            <h2 class="text-xl font-semibold text-gray-800">Hard Problems</h2>
            <p class="mt-2 text-gray-600 text-sm">Tackle hard problems to test your skills.</p>
            <a href="/problems?difficulty=Hard" class="mt-4 inline-block px-4 py-2 bg-red-100 text-red-800 text-sm font-medium rounded-full hover:bg-red-200 transition duration-300">Explore Hard</a>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 transition-transform transform hover:-translate-y-1">
            <h2 class="text-xl font-semibold text-gray-800">All Problems</h2>
            <p class="mt-2 text-gray-600 text-sm">View all available coding challenges.</p>
            <a href="/problems" class="mt-4 inline-block px-4 py-2 bg-blue-100 text-blue-800 text-sm font-medium rounded-full hover:bg-blue-200 transition duration-300">View All</a>
        </div>
    </div>

    <div class="container mx-auto mb-12 px-4">
         <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
            <h2 class="text-2xl font-semibold text-gray-800 mb-4">Recent Activity</h2>
            <p class="text-gray-600">User activity feed will be displayed here...</p>
            <ul class="mt-4 space-y-3">
                 <li class="p-3 bg-gray-50 rounded-md text-sm">User <span class="font-medium">Alice</span> solved <a href="#" class="text-blue-600 hover:underline">Two Sum</a>.</li>
                 <li class="p-3 bg-gray-50 rounded-md text-sm">User <span class="font-medium">Bob</span> attempted <a href="#" class="text-blue-600 hover:underline">Reverse Linked List</a>.</li>
                 <li class="p-3 bg-gray-50 rounded-md text-sm">User <span class="font-medium">Charlie</span> created a new draft problem.</li>
            </ul>
        </div>
    </div>

</div>


{{ template "footer" .}}