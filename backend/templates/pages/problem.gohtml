{{ template "header" .}}

    <div class=" min-h-screen mx-auto p-4 bg-gray-50">
        <div class="flex flex-col lg:flex-row gap-4">
            <!-- Problem Description Section -->
            <div class="lg:w-1/2">
                <div class="bg-white rounded-lg shadow-md p-6 mb-4">
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">Two Sum</h1>
                    <div class="flex items-center gap-2 mb-4">
                        <span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded">Easy</span>
                        <span class="text-sm text-gray-500">Acceptance: 48.2%</span>
                    </div>
                    <div class="prose max-w-none text-gray-700">
                        <p>Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target. You may assume that each input would have exactly one solution, and you may not use the same element twice.</p>
                        <h3>Example 1:</h3>
                        <pre class="bg-gray-50 p-4 rounded-lg">Input: nums = [2,7,11,15], target = 9
Output: [0,1]
Explanation: Because nums[0] + nums[1] == 9, we return [0, 1].</pre>
                        <h3>Constraints:</h3>
                        <ul>
                            <li>2 ≤ nums.length ≤ 10⁴</li>
                            <li>-10⁹ ≤ nums[i] ≤ 10⁹</li>
                            <li>-10⁹ ≤ target ≤ 10⁹</li>
                            <li>Only one valid answer exists.</li>
                        </ul>
                    </div>
                </div>

                <!-- Test Cases Section -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-semibold text-gray-900 mb-4">Test Cases</h2>
                    <div class="space-y-4">
                        <div class="flex items-center gap-2">
                            <button class="px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                Run Test Cases
                            </button>
                            <button class="px-4 py-2 text-sm font-medium text-blue-600 bg-blue-100 rounded-lg hover:bg-blue-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                                Add Test Case
                            </button>
                        </div>
                        <div class="space-y-2">
                            <div class="p-4 bg-gray-50 rounded-lg">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="font-medium text-gray-700">Test Case 1</span>
                                    <span class="text-green-500">Passed</span>
                                </div>
                                <pre class="text-sm text-gray-600">Input: nums = [2,7,11,15], target = 9
Expected: [0,1]
Output: [0,1]</pre>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Code Editor Section -->
            <div class="lg:w-1/2">
                <div class="bg-white rounded-lg shadow-md p-6 h-full">
                    <div class="flex items-center justify-between mb-4">
                        <label>
                            <select disabled class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2.5">
                                <option value="go">Golang</option>
                            </select>
                        </label>
                        <button class="px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
                            Submit Solution
                        </button>
                    </div>
                    <div class="w-full h-full">
                        <div id="editor" class="h-full rounded-lg "></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<script type="module">
    window.addEventListener("DOMContentLoaded", () => {
        const editor = window.highlight.createEditor("editor", `func main() {\n\t// your code here\n}`, "go");
        window.getUserCode = () => editor.getValue();
    });
</script>
{{template "footer" .}}