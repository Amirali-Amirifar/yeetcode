{{ template "header" . }}

<div class="min-h-screen bg-gray-50 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white shadow-sm rounded-lg">
            <!-- Header Section -->
            <div class="px-4 py-5 border-b border-gray-200 sm:px-6">
                <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
                <p class="mt-1 text-sm text-gray-500">Manage users and problem drafts.</p>
            </div>

            <!-- Tab Navigation -->
            <div class="border-b border-gray-200">
                <nav class="flex -mb-px">
                    <a href="/admin?tab=users" class="w-1/4 py-4 px-1 text-center border-b-2 font-medium text-sm {{ if eq .ActiveTab "users" }}border-indigo-500 text-indigo-600{{ else }}border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300{{ end }}">
                        Users
                    </a>
                    <a href="/admin?tab=drafts" class="w-1/4 py-4 px-1 text-center border-b-2 font-medium text-sm {{ if eq .ActiveTab "drafts" }}border-indigo-500 text-indigo-600{{ else }}border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300{{ end }}">
                        Draft Problems
                    </a>
                </nav>
            </div>

            <!-- Users Tab -->
            <div id="users-tab" class="mt-8 px-4 sm:px-6 pb-6" {{ if ne .ActiveTab "users" }}style="display: none;"{{ end }}>
                <div class="flex flex-col">
                    <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                        <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
                            <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Username</th>
                                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Role</th>
                                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        {{ if .Users }}
                                            {{ range .Users }}
                                                <tr>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ .Id }}</td>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ .Username }}</td>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ .Role }}</td>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                                        <form action="/admin/users/{{ .Id }}/toggle-role" method="POST">
                                                            <button type="submit" class="text-indigo-600 hover:text-indigo-900 {{ if eq .Role "admin" }}bg-red-100 hover:bg-red-200{{ else }}bg-green-100 hover:bg-green-200{{ end }} px-3 py-1 rounded">
                                                                {{ if eq .Role "admin" }}
                                                                    Demote to User
                                                                {{ else }}
                                                                    Promote to Admin
                                                                {{ end }}
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            {{ end }}
                                        {{ else }}
                                            <tr>
                                                <td colspan="4" class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">No users found</td>
                                            </tr>
                                        {{ end }}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Drafts Tab -->
            <div id="drafts-tab" class="mt-8 px-4 sm:px-6 pb-6" {{ if ne .ActiveTab "drafts" }}style="display: none;"{{ end }}>
                <div class="flex flex-col">
                    <div class="-my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                        <div class="py-2 align-middle inline-block min-w-full sm:px-6 lg:px-8">
                            <div class="shadow overflow-hidden border-b border-gray-200 sm:rounded-lg">
                                <table class="min-w-full divide-y divide-gray-200">
                                    <thead class="bg-gray-50">
                                        <tr>
                                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
                                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Author</th>
                                            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody class="bg-white divide-y divide-gray-200">
                                        {{ if .Drafts }}
                                            {{ range .Drafts }}
                                                <tr>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ .Id }}</td>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ .Title }}</td>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                                        {{ if .Owner }}
                                                            {{ .Owner.Username }}
                                                        {{ else }}
                                                            Unknown
                                                        {{ end }}
                                                    </td>
                                                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                                        <form action="/admin/drafts/{{ .Id }}/publish" method="POST">
                                                            <button type="submit" class="text-white bg-green-600 hover:bg-green-700 px-3 py-1 rounded">
                                                                Publish
                                                            </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            {{ end }}
                                        {{ else }}
                                            <tr>
                                                <td colspan="4" class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 text-center">No draft problems found</td>
                                            </tr>
                                        {{ end }}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ template "footer" . }} 