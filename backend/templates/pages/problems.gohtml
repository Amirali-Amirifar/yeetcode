{{ template "header" .}}

<div class="container mx-auto p-4 max-w-7xl">
    <!-- Search and Filters -->
    <form method="GET" action="/problems" class="mb-6 flex flex-col md:flex-row gap-4 items-center">
        <div class="flex-1 relative">
            <input type="search" id="search" name="search" value="{{ .SearchTerm }}" class="w-full p-3 pl-10 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" placeholder="Search problems...">
            <div class="absolute left-3 top-3.5 w-5 h-5 text-gray-400">
                <svg style="width: 20px !important; height: 20px !important;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
            </div>
        </div>
        <div class="flex gap-3">
            <select id="difficulty" name="difficulty" class="p-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200">
                <option value="">All Difficulties</option>
                <option value="easy" {{ if eq .Difficulty "easy" }}selected{{ end }}>Easy</option>
                <option value="medium" {{ if eq .Difficulty "medium" }}selected{{ end }}>Medium</option>
                <option value="hard" {{ if eq .Difficulty "hard" }}selected{{ end }}>Hard</option>
            </select>
            <button type="submit" class="px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200">
                Apply Filters
            </button>
            {{if .IsLoggedIn}}
            <a href="/problems/new" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition-all duration-200 flex items-center gap-2">
                <div class="w-5 h-5">
                    <svg style="width: 20px !important; height: 20px !important;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                </div>
                Create Problem
            </a>
            {{end}}
        </div>
    </form>

    <!-- All Problems Section -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200">
        <div class="p-4 border-b border-gray-200">
            <h2 class="text-xl font-semibold text-gray-800">All Problems</h2>
            {{ if gt .TotalCount 0 }}
                <p class="text-sm text-gray-600 mt-1">Showing {{ len .Problems }} of {{ .TotalCount }} problems</p>
            {{ end }}
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="p-4 text-left text-sm font-medium text-gray-500">Status</th>
                        <th class="p-4 text-left text-sm font-medium text-gray-500">Title</th>
                        <th class="p-4 text-left text-sm font-medium text-gray-500">Difficulty</th>
                        <th class="p-4 text-left text-sm font-medium text-gray-500">Acceptance</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {{ if .ErrorMessage }}
                        <tr>
                            <td colspan="4" class="p-8 text-center text-red-500">{{ .ErrorMessage }}</td>
                        </tr>
                    {{ else if eq (len .Problems) 0 }}
                        <tr>
                            <td colspan="4" class="p-8 text-center text-gray-500">No problems found matching your criteria.</td>
                        </tr>
                    {{ else }}
                        {{ range .Problems }}
                            <tr class="hover:bg-gray-50 transition-colors duration-150">
                                <td class="p-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                        {{ .Status }}
                                    </span>
                                </td>
                                <td class="p-4">
                                    <a href="/problems/{{ .ID }}" class="text-blue-600 hover:text-blue-800 hover:underline">
                                        {{ .Title }}
                                    </a>
                                </td>
                                <td class="p-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                                        {{ if eq .Difficulty "Easy" }}bg-green-100 text-green-800
                                        {{ else if eq .Difficulty "Medium" }}bg-yellow-100 text-yellow-800
                                        {{ else }}bg-red-100 text-red-800{{ end }}">
                                        {{ .Difficulty }}
                                    </span>
                                </td>
                                <td class="p-4 text-gray-600">N/A</td>
                            </tr>
                        {{ end }}
                    {{ end }}
                </tbody>
            </table>
        </div>
        
        <!-- Pagination Controls -->
        {{ if gt .TotalPages 1 }}
            <div class="p-4 border-t border-gray-200 flex justify-between items-center">
                <a href="{{ if .HasPrevPage }}/problems?page={{ .PrevPage }}{{ if .SearchTerm }}&search={{ .SearchTerm }}{{ end }}{{ if .Difficulty }}&difficulty={{ .Difficulty }}{{ end }}{{ else }}#{{ end }}" 
                   class="px-4 py-2 {{ if .HasPrevPage }}bg-blue-600 text-white{{ else }}bg-gray-200 text-gray-500 cursor-not-allowed{{ end }} rounded-lg hover:{{ if .HasPrevPage }}bg-blue-700{{ else }}bg-gray-200{{ end }}">
                    Previous
                </a>
                <span class="text-sm text-gray-600">Page {{ .CurrentPage }} of {{ .TotalPages }}</span>
                <a href="{{ if .HasNextPage }}/problems?page={{ .NextPage }}{{ if .SearchTerm }}&search={{ .SearchTerm }}{{ end }}{{ if .Difficulty }}&difficulty={{ .Difficulty }}{{ end }}{{ else }}#{{ end }}"
                   class="px-4 py-2 {{ if .HasNextPage }}bg-blue-600 text-white{{ else }}bg-gray-200 text-gray-500 cursor-not-allowed{{ end }} rounded-lg hover:{{ if .HasNextPage }}bg-blue-700{{ else }}bg-gray-200{{ end }}">
                    Next
                </a>
            </div>
        {{ end }}
    </div>
</div>

{{template "footer" .}}