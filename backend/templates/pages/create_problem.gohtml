{{ template "header" .}}

<div class="container mx-auto p-4 max-w-3xl">

    <!-- My Drafts Section -->
    {{if .Drafts}}
    <div class="mb-8 bg-white p-6 rounded-xl shadow-md border border-gray-200">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">My Drafts</h3>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-gray-50">
                        <th class="p-3 text-left font-medium text-gray-500">Title</th>
                        <th class="p-3 text-left font-medium text-gray-500">Difficulty</th>
                        <th class="p-3 text-left font-medium text-gray-500">Created</th>
                        <th class="p-3 text-left font-medium text-gray-500">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {{range .Drafts}}
                    <tr class="hover:bg-gray-50 transition-colors duration-150">
                        <td class="p-3 text-gray-800 font-medium">{{.Title}}</td>
                        <td class="p-3">
                            {{ $difficultyClass := "bg-red-100 text-red-800" }} {{/* Default to Hard */}}
                            {{ if eq .Difficulty "Easy" }}{{ $difficultyClass = "bg-green-100 text-green-800" }}{{ end }}
                            {{ if eq .Difficulty "Medium" }}{{ $difficultyClass = "bg-yellow-100 text-yellow-800" }}{{ end }}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ $difficultyClass }}">
                                {{.Difficulty}}
                            </span>
                        </td>
                        <td class="p-3 text-gray-600">{{.CreatedAt.Format "Jan 02, 2006"}}</td>
                        <td class="p-3">
                            <div class="flex gap-3">
                                <!-- Link to edit page (needs implementation) -->
                                <a href="/problems/{{.Id}}/edit" class="text-blue-600 hover:text-blue-800 hover:underline">Edit</a> 
                                <button onclick="deleteProblem({{.Id}})" class="text-red-600 hover:text-red-800 hover:underline">Delete</button>
                            </div>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
    {{end}}

    <div class="bg-white p-8 rounded-xl shadow-xl w-full">
        <div class="mb-6 pb-4 border-b border-gray-200">
            <h2 class="text-2xl font-semibold text-gray-800">Create a New Problem</h2>
        </div>
        
        <form id="problemForm" action="/api/problems" method="POST" class="space-y-5">
            <input type="hidden" id="problemId" name="problemId"> <!-- Keep hidden field for potential edits in future -->
            <div>
                <label for="title" class="block mb-1.5 text-sm font-medium text-gray-700">Title</label>
                <input type="text" id="title" name="title" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" required>
            </div>
            <div>
                <label for="description" class="block mb-1.5 text-sm font-medium text-gray-700">Description</label>
                <textarea id="description" name="description" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" rows="4" required></textarea>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div>
                    <label for="difficulty" class="block mb-1.5 text-sm font-medium text-gray-700">Difficulty</label>
                    <select id="difficulty" name="difficulty" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 bg-white" required>
                        <option>Easy</option>
                        <option>Medium</option>
                        <option>Hard</option>
                    </select>
                </div>
                <div>
                    <label for="timeLimit" class="block mb-1.5 text-sm font-medium text-gray-700">Time Limit (s)</label>
                    <input type="number" id="timeLimit" name="timeLimit" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" required step="0.1" min="0">
                </div>
                <div>
                    <label for="memoryLimit" class="block mb-1.5 text-sm font-medium text-gray-700">Memory Limit (MB)</label>
                    <input type="number" id="memoryLimit" name="memoryLimit" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200" required step="1" min="0">
                </div>
            </div>
            <div>
                <label for="testCases" class="block mb-1.5 text-sm font-medium text-gray-700">Test Cases (JSON)</label>
                <textarea id="testCases" name="testCases" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 font-mono text-sm transition-all duration-200" rows="6" required></textarea>
                <p class="mt-1 text-xs text-gray-500">Enter test cases as a JSON array of objects, e.g., `[{"input":"1 2","output":"3"}]`</p>
            </div>
            <div class="flex justify-end gap-3 pt-4">
                <a href="/problems" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg transition-all duration-200 text-sm font-medium">Cancel</a>
                <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all duration-200 text-sm font-medium flex items-center gap-1.5">
                     <svg xmlns="http://www.w3.org/2000/svg" style="width: 16px !important; height: 16px !important;" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                     </svg>
                    Save Problem
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Basic delete function example (adapt as needed)
    function deleteProblem(id) {
        if (confirm('Are you sure you want to delete this draft?')) {
            fetch(`/api/problems/${id}`, { method: 'DELETE' })
                .then(response => {
                    if (response.ok) {
                        // Reload page to show updated draft list
                        location.reload(); 
                    } else {
                        alert('Failed to delete draft.');
                    }
                })
                .catch(error => {
                    console.error('Error deleting draft:', error);
                    alert('Error deleting draft.');
                });
        }
    }
</script>

{{ template "footer" .}} 