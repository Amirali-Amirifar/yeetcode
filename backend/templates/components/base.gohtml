{{ define "base" }}
<!DOCTYPE html>
<html lang="en">
    <head>
        <title>{{ block "title" . }}Default Title{{ end }}</title>
        <link rel="stylesheet" href="/static/css/out.css"/>

        {{ block "head" . }}{{ end }}
    </head>
    <body>
    {{ template "header" .}}
    <main>
        {{ template "content" . }}

    </main>

    <footer>
        <!-- Common footer content -->
    </footer>

{{/*    {{ block "scripts" . }}{{ end }}*/}}
    </body>
</html>
{{ end }}